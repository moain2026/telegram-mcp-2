# Telegram app credentials from https://my.telegram.org
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_me

# Public HTTPS origin of this MCP service. Use localhost only for local development.
MCP_PUBLIC_BASE_URL=https://mcp.example.com
MCP_HOST=127.0.0.1
MCP_PORT=8080
MCP_PATH=/mcp
MCP_ALLOWED_HOSTS=mcp.example.com
MCP_ALLOWED_ORIGINS=https://mcp.example.com

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never rotate this value without a planned re-encryption migration.
MCP_SESSION_ENCRYPTION_KEY=replace_with_fernet_key

# MVP invite-code mapping. Replace with a real OIDC/SSO provider for production.
# JSON object: invite code -> internal service user id
MCP_INVITE_CODES={"invite-change-me":"user-001"}

MCP_DB_PATH=./data/multitenant.sqlite3
MCP_DOWNLOAD_ROOT=./data/downloads
